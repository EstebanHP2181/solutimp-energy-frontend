# Origen público del sitio (sin path de API, sin barra final).
# El cliente concatena rutas completas del API, p. ej. /api/v1/energy/...
#
# Producción (detrás de NGINX, mismo host que el SPA):
# VITE_API_BASE_URL=https://energy.solutimp.cl
#
# Desarrollo local (backend en otro puerto, sin NGINX):
# VITE_API_BASE_URL=http://localhost:8010
#
# Ejemplo de URL final resuelta por apiUrl('/api/v1/energy/bom/auto'):
#   https://energy.solutimp.cl/api/v1/energy/bom/auto
VITE_API_BASE_URL=

# Modo pruebas: inyecta <meta name="robots" content="noindex, nofollow" /> en el HTML (build/preview).
# En producción pública, dejar en false o no definir.
# VITE_ROBOTS_NOINDEX=true
