# Base pública del API (sin path de API, sin barra final).
# El cliente concatena rutas completas, p. ej. /api/v1/energy/...
#
# Producción (API en subdominio — ver .env.production y docs/DEPLOY-FRONTEND.md):
# VITE_API_BASE_URL=https://api.energy.solutimp.cl
#
# Desarrollo local (backend en otro puerto):
# VITE_API_BASE_URL=http://localhost:8010
#
# Ejemplo de URL final resuelta por apiUrl('/api/v1/energy/bom/auto'):
#   https://api.energy.solutimp.cl/api/v1/energy/bom/auto
VITE_API_BASE_URL=

# Modo pruebas: inyecta <meta name="robots" content="noindex, nofollow" /> en el HTML (build/preview).
# En producción pública, dejar en false o no definir.
# VITE_ROBOTS_NOINDEX=true
